{
  "name": "unret",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm --filter @unret/shared build && pnpm --filter @unret/api build && pnpm --filter @unret/web build",
    "db:migrate": "pnpm --filter @unret/api prisma:migrate",
    "db:seed": "pnpm --filter @unret/api seed",
    "test": "pnpm --filter @unret/api test"
  }
}
