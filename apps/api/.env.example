NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://unret:unret@localhost:5432/unret?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
FILE_SIGNING_SECRET=change-me-files
STORAGE_DIR=./uploads
PUBLIC_API_URL=
WEB_ORIGIN=http://localhost:3000
# Payments: "mock" simulates payments; "stripe" uses Stripe Connect (see docs/payments.md)
PAYMENT_PROVIDER=mock
# Stripe secret key: sk_test_... for test mode, sk_live_... for real money. Never commit a real key.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (whsec_...). Optional locally: the app also asks Stripe directly.
STRIPE_WEBHOOK_SECRET=
# Extra addresses Stripe may send customers back to (the app's web address), comma-separated. The website (WEB_ORIGIN) is always allowed.
APP_ORIGINS=
# Encryption key for sensitive data at rest (IBANs): 32 bytes as 64 hex characters. Required in production.
DATA_ENCRYPTION_KEY=
# Email (SMTP). Works with Brevo, SendGrid, Postmark, Amazon SES, Mailgun, Gmail... Without SMTP_HOST emails are only logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=UNRET <no-reply@unret.ro>
# Website address used for links in emails (defaults to the first WEB_ORIGIN)
PUBLIC_WEB_URL=
